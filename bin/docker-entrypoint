#!/bin/bash -e

# If running the rails server (optionally via Thruster, and with any extra
# flags such as -b) then create or migrate existing database
rails_server_command() {
  local prev=""
  for arg in "$@"; do
    if [ "$prev" == "./bin/rails" ] && [ "$arg" == "server" ]; then
      return 0
    fi
    prev="$arg"
  done
  return 1
}

if rails_server_command "$@"; then
  # Create or migrate all four databases, then load the game content from content/. The import is
  # idempotent and runs in one transaction, so new shifts go live with each deploy and a bad
  # content file stops the boot (kamal-proxy keeps serving the old container) instead of
  # half-importing.
  ./bin/rails db:prepare
  ./bin/rails content:import
fi

exec "${@}"
