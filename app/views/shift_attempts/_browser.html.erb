<%# The in-game browser. Rendered only once the player has opened a link or attachment: the page it
    shows is the consequence of that choice. No class, id or attribute here may name the outcome. %>
<div id="shift_browser">
  <% if (tab = attempt.current_tab) %>
    <dialog class="browser m-auto w-[min(56rem,calc(100vw-2rem))] max-h-[calc(100vh-2rem)] rounded-xl border border-line bg-surface p-0 text-ink shadow-2xl"
            aria-labelledby="browser-title" data-controller="browser" data-action="cancel->browser#cancel">
      <div class="flex items-center justify-between gap-3 border-b border-line bg-surface-sunken px-3 py-2">
        <p id="browser-title" class="truncate text-sm font-medium"><%= tab.title %></p>
        <%= button_to "Close tab", shift_attempt_tab_path(attempt), method: :delete, class: "btn-ghost py-1",
              form: { class: "contents" }, data: { browser_target: "close" } %>
      </div>

      <% if tab.address %>
        <div class="flex items-center gap-2 border-b border-line bg-surface-raised px-3 py-2">
          <span class="text-xs text-ink-muted" aria-hidden="true"><%= tab.padlock? ? "🔒" : "⚠️" %></span>
          <p class="min-w-0 flex-1 truncate rounded-md bg-surface-sunken px-3 py-1 font-mono text-sm" data-testid="address-bar">
            <span class="sr-only">Address: </span><%= tab.address %>
          </p>
        </div>
      <% end %>

      <div class="max-h-[70vh] overflow-y-auto bg-white text-slate-900">
        <%= render landing_partial(tab), attempt:, tab: %>
      </div>
    </dialog>
  <% end %>
</div>
