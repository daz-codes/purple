<section id="shift_tasks" class="card p-4" aria-labelledby="tasks-heading">
  <h2 id="tasks-heading" class="text-lg font-bold">Tasks</h2>
  <p class="mt-1 text-sm text-ink-muted">Finish these through the links in your messages.</p>
  <ul class="mt-4 space-y-2">
    <% attempt.shift.tasks.each do |task| %>
      <% state = task_state(attempt, task) %>
      <li class="rounded-lg border px-3 py-2 <%= { done: "border-blue-team/60 bg-blue-team-soft", overdue: "border-red-team/60 bg-red-team-soft", pending: "border-line" }.fetch(state) %>">
        <p class="font-medium"><%= task.title %></p>
        <p class="text-sm text-ink-muted">
          Due by minute <%= task.due_at_minute %> ·
          <span class="font-semibold <%= { done: "text-blue-team", overdue: "text-red-team", pending: "" }.fetch(state) %>"><%= { done: "Done", overdue: "Overdue", pending: "To do" }.fetch(state) %></span>
        </p>
      </li>
    <% end %>
  </ul>
  <% if attempt.all_tasks_resolved? %>
    <p class="mt-4 rounded-lg border border-purple-team/60 bg-purple-team-soft px-3 py-2 text-sm" data-testid="tasks-clear">
      Nothing left on your list, so the rest of today's mail has arrived. Deal with your inbox, then end your shift.
    </p>
  <% end %>
</section>
