<%# The player's own details for this attempt, and who they can check with. All of it is the player's
    to see: nothing here says how sensitive a detail is, or who may have it. %>
<% persona = attempt.persona %>
<% if persona.present? %>
  <section class="card p-4" aria-labelledby="persona-heading" data-testid="persona-card">
    <h2 id="persona-heading" class="text-lg font-bold">Your details</h2>
    <p class="mt-1 text-sm"><span class="font-semibold"><%= persona.name %></span>, <%= persona.role %></p>
    <dl class="mt-3 grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 text-sm">
      <dt class="text-ink-muted">Staff number</dt><dd class="font-mono" data-testid="persona-staff-number"><%= persona.staff_number %></dd>
      <dt class="text-ink-muted">Desk extension</dt><dd class="font-mono"><%= persona.extension %></dd>
      <dt class="text-ink-muted">Memorable word</dt><dd class="font-mono" data-testid="persona-memorable-word"><%= persona.memorable_word %></dd>
      <dt class="text-ink-muted"><%= persona.security_question %></dt><dd class="font-mono"><%= persona.security_answer %></dd>
    </dl>
    <p class="mt-3 text-xs text-ink-muted">Made up for this shift. Never put your real details into the game.</p>
  </section>
<% end %>

<% if attempt.shift.directory.any? %>
  <section class="card p-4" aria-labelledby="directory-heading" data-testid="staff-directory">
    <h2 id="directory-heading" class="text-lg font-bold">Staff directory</h2>
    <ul class="mt-2 space-y-2 text-sm">
      <% attempt.shift.directory.each do |entry| %>
        <li>
          <span class="font-semibold"><%= entry["name"] %></span><% if entry["team"] %> <span class="text-ink-muted">· <%= entry["team"] %></span><% end %>
          <span class="block text-ink-muted"><%= entry["contact"] %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
