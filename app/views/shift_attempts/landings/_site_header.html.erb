<%# Every web page gets the same header, so no page's look gives its nature away. %>
<% if tab.host %>
<header class="flex items-center gap-3 border-b border-slate-200 bg-slate-50 px-6 py-3">
  <span class="grid size-8 place-items-center rounded-md bg-slate-800 text-sm font-bold text-white" aria-hidden="true"><%= tab.host.to_s.first.upcase %></span>
  <span class="font-semibold"><%= tab.host %></span>
</header>
<% end %>
