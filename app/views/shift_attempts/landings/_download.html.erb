<%= render "shift_attempts/landings/site_header", tab: %>
<div class="px-6 py-10">
  <div class="mx-auto max-w-md rounded-xl border border-slate-200 p-6 shadow-sm">
    <h2 class="text-xl font-bold">Open this file?</h2>
    <p class="mt-4 flex items-center gap-3 rounded-lg bg-slate-100 px-4 py-3 font-mono text-sm break-all">
      <span aria-hidden="true">📄</span> <%= tab.file_name %>
    </p>
    <p class="mt-4 text-sm text-slate-600">This file is ready to open. Only open files you trust.</p>
    <div class="mt-6 flex justify-end gap-3">
      <%= button_to "Cancel", shift_attempt_tab_path(attempt), method: :delete, class: "btn border border-slate-300 hover:bg-slate-100" %>
      <%= button_to "Open file", shift_attempt_tab_download_run_path(attempt), class: "btn bg-slate-900 text-white hover:bg-slate-700" %>
    </div>
  </div>
</div>
