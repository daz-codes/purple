<%= render "shift_attempts/landings/site_header", tab: %>
<div class="px-6 py-8">
  <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">Waiting for you</p>
  <h2 class="mt-2 text-2xl font-bold"><%= tab.portal_action %></h2>

  <% if tab.fields.any? %>
    <%= form_with url: shift_attempt_tab_portal_submission_path(attempt), class: "mt-6 max-w-sm space-y-4" do %>
      <%= render "shift_attempts/landings/detail_fields", attempt:, tab: %>
      <button type="submit" class="btn bg-slate-900 text-white hover:bg-slate-700"><%= tab.portal_action %></button>
    <% end %>
  <% else %>
    <div class="mt-6">
      <%= shift_action_button tab.portal_action, shift_attempt_tab_portal_submission_path(attempt),
            class: "btn bg-slate-900 text-white hover:bg-slate-700" %>
    </div>
  <% end %>
</div>
