<%# The Purple debrief. Only rendered once the shift is over: it names the answers. %>
<% scorecard = attempt.scorecard %>
<% shift = attempt.shift %>

<nav aria-label="Breadcrumb" class="text-sm text-ink-muted mb-4">
  <%= link_to "Shifts", tracks_path, class: "hover:text-ink" %> / <%= link_to shift.track.title, shift.track, class: "hover:text-ink" %>
</nav>

<div class="space-y-6">
  <section class="card border-purple-team/50" aria-labelledby="results-heading">
    <p class="text-sm font-semibold uppercase tracking-widest text-purple-team">Purple debrief</p>
    <h1 id="results-heading" class="mt-2 text-3xl font-extrabold tracking-tight"><%= shift.title %></h1>
    <p class="mt-2 text-ink-muted" data-testid="debrief-ending"><%= debrief_ending(attempt, scorecard) %></p>

    <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="text-3xl"><%= debrief_stars(scorecard.stars) %></span>
      <p class="font-semibold" data-testid="debrief-headline"><%= debrief_headline(scorecard) %></p>
    </div>
    <%= render "shared/xp_earned", source: attempt %>

    <dl class="mt-6 grid gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-purple-team/60 bg-purple-team-soft p-4">
        <dt class="text-sm text-ink-muted">Score</dt>
        <dd><span class="text-4xl font-extrabold" data-testid="score"><%= scorecard.total %></span>
          <span class="text-ink-muted">out of <%= scorecard.best_possible %></span></dd>
      </div>
      <div class="rounded-xl border border-line p-4">
        <dt class="text-sm text-ink-muted">Messages</dt>
        <dd><span class="text-3xl font-bold" data-testid="message-points"><%= scorecard.message_points %></span></dd>
        <dd class="mt-1 text-xs text-ink-muted">
          Genuine messages: their points when you did what they needed, half if an urgent one was late, minus half if not,
          <%= debrief_points(ShiftAttempt::Scorecard::REPORTED_GENUINE) %> if reported.
          Phishes: <%= debrief_points(ShiftAttempt::Scorecard::REPORTED_PHISH) %> reported,
          <%= debrief_points(ShiftAttempt::Scorecard::NEAR_MISS) %> per close call,
          <%= debrief_points(ShiftAttempt::Scorecard::COMPROMISED) %> each time you fell for one.
          Each red flag you spot earns its points, and each wrong flag costs <%= ShiftAttempt::Scorecard::FALSE_FLAG.abs %>.
        </dd>
      </div>
      <div class="rounded-xl border border-line p-4">
        <dt class="text-sm text-ink-muted">Speed bonus</dt>
        <dd><span class="text-3xl font-bold" data-testid="speed-bonus"><%= debrief_points(scorecard.speed_bonus) %></span></dd>
        <dd class="mt-1 text-xs text-ink-muted">
          <% if scorecard.relaxed? %>
            Not timed: you played in relaxed mode.
          <% else %>
            <%= debrief_points(ShiftAttempt::Scorecard::SPEED_BLOCK_POINTS) %> for each full 5 minutes under the
            <%= shift.par_minutes %>-minute target, for clearing everything. Each call-back adds <%= ShiftAttempt::Timed::CALL_PENALTY %> seconds.
          <% end %>
        </dd>
      </div>
    </dl>

    <% if scorecard.hints.any? %>
      <div class="mt-4 rounded-xl border border-warn/60 bg-warn-soft p-4" data-testid="debrief-hints">
        <p class="font-semibold text-warn">Hints: <%= debrief_points(-scorecard.hint_penalty) %></p>
        <ul class="mt-1 space-y-1 text-sm">
          <% scorecard.hints.each do |used| %>
            <li>💡 <%= used.hint.body %> <span class="text-ink-muted">(<%= debrief_points(-used.penalty) %>)</span></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <% if scorecard.compromised? %>
      <p class="mt-4 text-sm text-ink-muted">Three stars need a shift where you don't fall for anything.</p>
    <% end %>
  </section>

  <section aria-labelledby="messages-heading">
    <h2 id="messages-heading" class="text-xl font-bold">Message by message</h2>
    <p class="mt-1 text-sm text-ink-muted">Everything in the shift, in the order it arrived.</p>
    <ol class="mt-4 space-y-4">
      <% scorecard.messages.each do |result| %>
        <%= render "shift_attempts/debrief/message", result: %>
      <% end %>
    </ol>
  </section>

  <section class="card" aria-labelledby="timeline-heading">
    <details>
      <summary class="cursor-pointer">
        <h2 id="timeline-heading" class="inline text-xl font-bold">Your shift, move by move</h2>
      </summary>
      <ol class="mt-4 space-y-1 text-sm" data-testid="debrief-timeline">
        <% debrief_timeline(attempt.actions, scorecard).each do |seconds, description, tone| %>
          <li class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-2">
            <span class="text-ink-muted tabular-nums"><%= debrief_clock(seconds) %></span>
            <span class="<%= debrief_text_class(tone) %>"><%= description %></span>
          </li>
        <% end %>
      </ol>
    </details>
  </section>

  <section class="card border-purple-team/50" aria-labelledby="takeaway-heading">
    <h2 id="takeaway-heading" class="text-xl font-bold">Take this with you</h2>
    <p class="mt-2"><%= shift.learning_summary %></p>

    <div class="mt-6 flex flex-wrap gap-3">
      <%= button_to "Play again", shift_attempts_path(shift), class: "btn-blue" %>
      <%= link_to "Back to #{shift.track.title}", shift.track, class: "btn-ghost" %>
    </div>
  </section>
</div>
