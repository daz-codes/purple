<% message = attempt.current_message %>
<% flag_mode = local_assigns[:flag_mode] && message %>
<% flagged = message ? attempt.flagged_anchors(message) : [] %>
<%# Flag mode: every header, paragraph, link and attachment carries a neutral data-anchor, and any of
    them can be flagged, so nothing here says which parts are red flags. %>
<section id="shift_reader" class="card p-0 overflow-hidden min-h-[28rem]" aria-labelledby="reader-heading"
         data-controller="link-status flag-mode"
         data-flag-mode-active-value="<%= flag_mode ? "true" : "false" %>"
         data-flag-mode-flagged-value="<%= flagged.to_json %>"
         data-action="click->flag-mode#pick:capture keydown->flag-mode#keydown:capture turbo:submit-end->flag-mode#submitted">
  <% if message %>
    <% expanded = attempt.headers_expanded?(message) %>
    <% ref = attempt.message_ref(message) %>
    <header class="p-5 border-b border-line">
      <% if message.subject.present? %>
        <h2 id="reader-heading" class="text-xl font-bold"><span data-anchor="subject"><%= message.subject %></span></h2>
      <% else %>
        <h2 id="reader-heading" class="text-xl font-bold">Message from <%= message.from_name %></h2>
      <% end %>

      <dl class="mt-3 grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 text-sm">
        <dt class="text-ink-muted">From</dt>
        <dd class="break-words"><span data-anchor="from"><strong><%= message.from_name %></strong><% if expanded %> <span class="font-mono">&lt;<%= message.from_address %>&gt;</span><% end %></span></dd>
        <% if expanded %>
          <% if message.reply_to.present? %>
            <dt class="text-ink-muted">Reply-To</dt>
            <dd class="font-mono break-words"><span data-anchor="reply_to"><%= message.reply_to %></span></dd>
          <% end %>
          <% if message.to_address.present? %>
            <dt class="text-ink-muted">To</dt>
            <dd class="font-mono break-words"><span data-anchor="to"><%= message.to_address %></span></dd>
          <% end %>
        <% end %>
        <dt class="text-ink-muted">Received</dt>
        <dd>Minute <%= message.arrives_at_minute %></dd>
      </dl>

      <div class="mt-4 flex flex-wrap gap-2">
        <% unless expanded %>
          <%= shift_action_button attempt, "Show full headers", shift_attempt_message_headers_path(attempt, ref),
                cost: attempt.action_cost(:expand_headers) %>
        <% end %>
        <% unless attempt.sender_verified?(message) %>
          <%= shift_action_button attempt, "Call the sender back", shift_attempt_message_verification_path(attempt, ref),
                cost: attempt.action_cost(:verify_sender) %>
        <% end %>
        <button type="button" class="btn-ghost aria-pressed:border-red-team aria-pressed:bg-red-team-soft aria-pressed:text-red-team" data-action="flag-mode#toggle" data-flag-mode-target="toggle"
                aria-pressed="<%= flag_mode ? "true" : "false" %>">🚩 Flag red flags</button>
        <%= shift_action_button attempt, "Report phishing", shift_attempt_message_report_path(attempt, ref),
              cost: attempt.action_cost(:report_message), class: "btn-red" %>
      </div>

      <%= render "shift_attempts/reader/flagging", attempt:, message:, ref:, flagged:, flag_mode: %>
      <%= render "shift_attempts/reader/verification", attempt:, message: %>
    </header>

    <%# Links post only their neutral key (l1, l2…) to this URL; the server decides what opens. %>
    <div class="message-body p-5"
         data-link-visit-url="<%= shift_attempt_message_link_visit_path(attempt, ref, "__key__") %>"
         data-action="mouseover->link-status#show mouseout->link-status#hide focusin->link-status#show focusout->link-status#hide">
      <%= sanitize message.body_html, tags: Content::MessageBody::OUTPUT_TAGS, attributes: Content::MessageBody::OUTPUT_ATTRIBUTES %>
    </div>

    <% if message.visible_attachments.any? %>
      <ul class="px-5 pb-5 flex flex-wrap gap-2" aria-label="Attachments">
        <% message.visible_attachments.each do |attachment| %>
          <li data-anchor="<%= attachment["id"] %>">
            <%= button_to shift_attempt_message_attachment_opening_path(attempt, ref, attachment["id"]),
                  class: "rounded-lg border border-line bg-surface-sunken px-3 py-2 text-sm cursor-pointer hover:border-blue-team",
                  aria: { label: "Open attachment #{attachment["name"]}" } do %>
              📎 <span class="font-medium"><%= attachment["name"] %></span> <span class="text-ink-muted"><%= attachment["size"] %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <p class="border-t border-line bg-surface-sunken px-5 py-2 font-mono text-xs text-ink-muted break-all" data-link-status-target="bar" hidden></p>
  <% else %>
    <h2 id="reader-heading" class="sr-only">Reading pane</h2>
    <p class="p-8 text-center text-ink-muted">Pick a message from your inbox to read it.</p>
  <% end %>
</section>
