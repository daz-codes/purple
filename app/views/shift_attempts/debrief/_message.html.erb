<% message = result.message %>
<% verdict, tone = debrief_verdict(result) %>
<li class="card space-y-4" data-testid="debrief-message">
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="flex flex-wrap items-center gap-2 text-sm">
        <span class="rounded-full border px-2 py-0.5 font-semibold <%= debrief_tone_classes(tone) %>" data-testid="debrief-verdict"><%= verdict %></span>
        <% if result.arrived? %><span class="text-ink-muted">Arrived at <%= debrief_clock(result.arrived_at) %></span><% end %>
      </p>
      <h3 class="mt-2 text-lg font-bold break-words"><%= message.subject.presence || "Message from #{message.from_name}" %></h3>
      <p class="text-sm text-ink-muted break-words">
        <% unless message.email? %><%= channel_label(message) %> from <% end %><%= message.from_name %>
        <% if message.from_address != message.from_name %><span class="font-mono">&lt;<%= message.from_address %>&gt;</span><% end %>
        <% if message.reply_to.present? %>
          · replies go to <span class="font-mono"><%= message.reply_to %></span>
        <% end %>
      </p>
    </div>
    <p class="text-2xl font-extrabold tabular-nums <%= debrief_text_class(tone) %>" data-testid="debrief-points"
       aria-label="<%= debrief_points(result.points) %> points"><%= debrief_points(result.points) %></p>
  </header>

  <div class="space-y-2" data-testid="debrief-story">
    <% debrief_story(result).each do |sentence| %>
      <p><%= sentence %></p>
    <% end %>
    <% if (verification = debrief_verification(result)) %>
      <p class="text-sm text-ink-muted"><%= verification %></p>
    <% end %>
    <% if (false_flags = debrief_false_flags(result)) %>
      <p class="text-sm text-warn" data-testid="debrief-false-flags">🚩 <%= false_flags %></p>
    <% end %>
  </div>

  <% if (paragraphs = debrief_marked_paragraphs(result)).any? %>
    <div class="rounded-lg border border-line bg-surface-sunken px-4 py-3 text-sm" data-testid="debrief-marked-text">
      <p class="mb-2 text-xs text-ink-muted">
        The message, with <span class="bg-safe-soft px-1">your highlights that found something</span>,
        <span class="bg-warn-soft px-1">ones that didn't</span>, and the giveaways
        <span class="underline decoration-2 decoration-safe">you found</span> or
        <span class="underline decoration-2 decoration-red-team">missed</span>.
      </p>
      <% paragraphs.each do |segments| %>
        <p class="mt-1"><% segments.each do |text, classes| %><% if classes %><mark class="<%= classes %> text-ink"><%= text %></mark><% else %><%= text %><% end %><% end %></p>
      <% end %>
    </div>
  <% end %>

  <% if (lessons = debrief_lessons(result)).any? %>
    <div class="rounded-lg border border-purple-team/60 bg-purple-team-soft px-4 py-3">
      <p class="text-sm font-semibold text-purple-team">Next time</p>
      <% lessons.each do |lesson| %>
        <p class="mt-1"><%= lesson %></p>
      <% end %>
    </div>
  <% end %>

  <% if result.phish? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% if message.red_flags.any? %>
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-widest text-red-team">
            The giveaways <span class="normal-case tracking-normal text-ink-muted">· you flagged <%= result.found_flags.size %> of <%= message.red_flags.size %></span>
          </h4>
          <ul class="mt-2 space-y-2 text-sm" data-testid="debrief-red-flags">
            <% debrief_red_flags(result).each do |flag, found| %>
              <li>
                <span class="mr-1 rounded-full border px-1.5 text-xs font-semibold <%= debrief_tone_classes(found ? :good : :neutral) %>">
                  <%= found ? "Flagged #{debrief_points(flag.points)}" : "Missed" %>
                </span>
                <span class="font-semibold"><%= flag.label %>.</span>
                <% if flag.quote? %><span class="italic">“<%= flag.quote %>”</span><% end %>
                <%= flag.explanation %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if message.techniques.any? %>
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-widest text-red-team">Red's playbook</h4>
          <ul class="mt-2 space-y-2 text-sm">
            <% message.techniques.sort_by(&:name).each do |technique| %>
              <li>
                <span class="font-semibold"><%= technique.name %></span>
                <% if technique.attack_id %>
                  <%= link_to technique.attack_id, technique.attack_url, target: "_blank", rel: "noopener noreferrer",
                        class: "font-mono text-xs text-ink-muted underline", title: "MITRE ATT&CK #{technique.attack_id}" %>
                <% end %>
                <span class="block text-ink-muted"><%= technique.defence_tip %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% end %>
</li>
