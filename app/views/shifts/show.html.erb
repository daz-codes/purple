<% content_for :title, @shift.title %>

<nav aria-label="Breadcrumb" class="text-sm text-ink-muted mb-4">
  <%= link_to "Shifts", tracks_path, class: "hover:text-ink" %> / <%= link_to @shift.track.title, @shift.track, class: "hover:text-ink" %>
</nav>

<div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] items-start">
  <section class="card border-red-team/50" aria-labelledby="briefing-heading">
    <p class="text-sm font-semibold uppercase tracking-widest text-red-team">Briefing</p>
    <h1 id="briefing-heading" class="mt-2 text-3xl font-extrabold tracking-tight"><%= @shift.title %></h1>
    <p class="mt-4 text-lg"><%= @shift.briefing %></p>
    <p class="mt-4 text-ink-muted">
      Red's campaign is somewhere in today's <%= @shift.kind_inbox? ? "inbox" : "messages" %>. Your job is still your job:
      deal with everything that comes in, and don't let the phishing through.
    </p>
  </section>

  <aside class="card" aria-labelledby="day-heading">
    <h2 id="day-heading" class="text-lg font-bold">How it works</h2>
    <ul class="mt-3 space-y-2 text-sm">
      <li>Deal with every <%= @shift.kind_inbox? ? "email" : "message" %>: reply, do what it asks, archive it when you're done, or report it.</li>
      <li>More arrive as you work. The shift ends when <%= @shift.kind_inbox? ? "your inbox" : "your phone" %> is clear.</li>
      <li>Calling a sender back is always allowed, but takes a little time.</li>
      <% if authenticated? && Current.user.relaxed_mode? %>
        <li>You're in <%= link_to "relaxed mode", account_path, class: "underline" %>: take as long as you like.</li>
      <% else %>
        <li>Clear it in under <%= @shift.par_minutes %> minutes for a speed bonus. Prefer no timing? Try
          <%= link_to "relaxed mode", authenticated? ? account_path : new_session_path, class: "underline" %>.</li>
      <% end %>
      <li>Nothing tells you how you're doing until the debrief.</li>
    </ul>

    <div class="mt-6">
      <% if @open_attempt %>
        <%= link_to "Resume shift", @open_attempt, class: "btn-blue w-full" %>
      <% elsif authenticated? %>
        <%= button_to "Start shift", shift_attempts_path(@shift), class: "btn-blue w-full" %>
      <% else %>
        <%# Goes through a sign-in-only page, so signing in returns here without every briefing view setting return_to. %>
        <%= link_to "Sign in to play", new_shift_attempt_path(@shift), class: "btn-blue w-full" %>
      <% end %>
    </div>
  </aside>
</div>
