<% content_for :title, "Create an account" %>

<%= render layout: "shared/auth_card", locals: { title: "Create an account", intro: "Pick a side later. First, a name for the leaderboard." } do %>
  <%= render "shared/form_errors", record: @user %>

  <%= form_with model: @user, url: registration_path, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :display_name, class: "form-label" %>
      <%= form.text_field :display_name, required: true, autofocus: true, autocomplete: "nickname",
            minlength: 3, maxlength: 20, pattern: "[A-Za-z0-9_]+", aria: { describedby: "display_name_hint" }, class: "form-input" %>
      <p id="display_name_hint" class="mt-1 text-xs text-ink-muted">3–20 letters, numbers or underscores. Shown publicly.</p>
    </div>

    <div>
      <%= form.label :email_address, "Email address", class: "form-label" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email", class: "form-input" %>
    </div>

    <div>
      <%= form.label :password, class: "form-label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password",
            minlength: User::PASSWORD_LENGTH.min, maxlength: User::PASSWORD_LENGTH.max,
            aria: { describedby: "password_hint" }, class: "form-input" %>
      <p id="password_hint" class="mt-1 text-xs text-ink-muted">At least <%= User::PASSWORD_LENGTH.min %> characters. A few random words work well.</p>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "form-label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
            maxlength: User::PASSWORD_LENGTH.max, class: "form-input" %>
    </div>

    <%= form.submit "Create account", class: "btn-primary w-full" %>
  <% end %>

  <p class="mt-6 text-sm text-ink-muted">
    Already playing? <%= link_to "Sign in", new_session_path, class: "text-purple-team underline" %>
  </p>
<% end %>
