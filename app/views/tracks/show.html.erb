<% content_for :title, @track.title %>

<nav aria-label="Breadcrumb" class="text-sm text-ink-muted mb-4"><%= link_to "Shifts", tracks_path, class: "hover:text-ink" %> / <%= @track.title %></nav>

<header class="mb-8">
  <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight"><%= @track.title %></h1>
  <p class="mt-3 max-w-2xl text-ink-muted"><%= @track.description %></p>
</header>

<ol class="space-y-4">
  <% @shifts.each_with_index do |shift, index| %>
    <li class="card flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-ink-muted">
          Shift <%= index + 1 %> · <%= shift.kind_inbox? ? "Inbox" : "Messages" %> · <%= shift.time_budget_minutes %> minutes
        </p>
        <h2 class="mt-1 text-xl font-bold"><%= shift.title %></h2>
        <% if (best = @best_attempts[shift.id]) %>
          <% scorecard = best.scorecard %>
          <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm" data-testid="shift-progress">
            <span class="rounded-full border px-2 py-0.5 font-semibold <%= debrief_tone_classes(best.completed? ? :good : :warn) %>"><%= best.completed? ? "Completed" : "Ran out of time" %></span>
            <span class="text-lg"><%= debrief_stars(scorecard.stars) %></span>
            <span>Best score <strong><%= scorecard.total %></strong> <span class="text-ink-muted">out of <%= scorecard.total_max %></span></span>
            <%= link_to "See debrief", best, class: "text-purple-team underline" %>
          </p>
        <% end %>
      </div>
      <%= link_to best ? "Play again" : "Read the briefing", shift, class: best ? "btn-ghost" : "btn-blue" %>
    </li>
  <% end %>
</ol>
