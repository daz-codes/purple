<% content_for :title, "Shifts" %>

<header class="mb-8">
  <p class="text-sm font-semibold uppercase tracking-widest text-blue-team">Blue team</p>
  <h1 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight">Pick a track</h1>
  <p class="mt-3 max-w-2xl text-ink-muted">
    Each track is a run of shifts at a fictional company. Deal with everything that lands in your
    inbox, and catch Red's phishing on the way.
  </p>
</header>

<div class="grid gap-6 md:grid-cols-2">
  <% @tracks.each do |track| %>
    <article class="card flex flex-col">
      <p class="text-xs font-semibold uppercase tracking-widest text-ink-muted"><%= track.difficulty.humanize %></p>
      <h2 class="mt-2 text-2xl font-bold"><%= link_to track.title, track, class: "hover:text-blue-team" %></h2>
      <p class="mt-3 text-ink-muted flex-1"><%= track.description %></p>
      <p class="mt-4 text-sm text-ink-muted"><%= pluralize(track.shifts.count(&:published?), "shift") %></p>
    </article>
  <% end %>
</div>
