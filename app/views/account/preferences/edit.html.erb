<% content_for :title, "Settings" %>

<div class="mx-auto w-full max-w-2xl">
  <h1 class="text-2xl font-bold">Settings</h1>

  <%= form_with model: Current.user, url: account_preferences_path, method: :patch, class: "card mt-6 space-y-4" do |form| %>
    <div class="flex items-start gap-3">
      <%= form.check_box :relaxed_mode, class: "mt-1 size-5 accent-purple-team" %>
      <div>
        <%= form.label :relaxed_mode, "Relaxed mode", class: "font-semibold" %>
        <p class="text-sm text-ink-muted">
          Take as long as you like. Shifts aren't timed: there's no speed bonus, and urgent messages don't lose points
          for being late. Relaxed scores are kept separately on the leaderboards. Changes apply to shifts you start from now on.
        </p>
      </div>
    </div>
    <%= form.submit "Save settings", class: "btn-primary" %>
  <% end %>
</div>
