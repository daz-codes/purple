<% content_for :title, "Sign in" %>

<%= render layout: "shared/auth_card", locals: { title: "Sign in" } do %>
  <%= form_with url: session_path, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email address", class: "form-label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address], class: "form-input" %>
    </div>

    <div>
      <%= form.label :password, class: "form-label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "form-input" %>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <%= form.submit "Sign in", class: "btn-primary" %>
      <%= link_to "Forgot password?", new_password_path, class: "text-sm text-ink-muted underline hover:text-ink" %>
    </div>
  <% end %>

  <p class="mt-6 text-sm text-ink-muted">
    New here? <%= link_to "Create an account", new_registration_path, class: "text-purple-team underline" %>
  </p>
<% end %>
