<%# The Purple debrief for a Red campaign, replayed from what was stored at launch. %>
<% target = campaign.target %>
<% bots = BotPersona.where(key: campaign.results.map { |result| result["bot"] }).index_by(&:key) %>
<% techniques = Technique.where(key: campaign.results.filter_map { |result| result["gave_away"] }).index_by(&:key) %>

<div class="space-y-6">
  <section class="card border-purple-team/50" aria-labelledby="campaign-heading">
    <p class="text-sm font-semibold uppercase tracking-widest text-purple-team">Purple debrief</p>
    <h1 id="campaign-heading" class="mt-2 text-3xl font-extrabold tracking-tight"><%= target.title %></h1>

    <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="text-3xl"><%= debrief_stars(campaign.stars) %></span>
      <p class="font-semibold" data-testid="campaign-headline">
        You fooled <%= campaign.results.count { |result| result["outcome"] == "fooled" } %> of <%= pluralize(campaign.results.size, "bot") %>.
      </p>
    </div>
    <%= render "shared/xp_earned", source: campaign %>

    <dl class="mt-6 grid gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-purple-team/60 bg-purple-team-soft p-4">
        <dt class="text-sm text-ink-muted">Score</dt>
        <dd><span class="text-4xl font-extrabold" data-testid="campaign-score"><%= campaign.score %></span>
          <span class="text-ink-muted">out of <%= campaign.max_score %></span></dd>
      </div>
      <div class="rounded-xl border border-line p-4">
        <dt class="text-sm text-ink-muted">From the bots</dt>
        <dd class="text-3xl font-bold"><%= campaign.score - campaign.budget_left %></dd>
        <dd class="mt-1 text-xs text-ink-muted">+<%= RedCampaign::Launchable::FOOLED %> per bot fooled, +<%= RedCampaign::Launchable::NEAR_MISS %> per near miss.</dd>
      </div>
      <div class="rounded-xl border border-line p-4">
        <dt class="text-sm text-ink-muted">Budget left</dt>
        <dd class="text-3xl font-bold"><%= campaign.budget_left %></dd>
        <dd class="mt-1 text-xs text-ink-muted">A point for every unit you didn't spend.</dd>
      </div>
    </dl>
  </section>

  <section aria-labelledby="bots-heading">
    <h2 id="bots-heading" class="text-xl font-bold">What the bots did</h2>
    <ol class="mt-4 grid gap-4 md:grid-cols-3">
      <% campaign.results.each_with_index do |result, index| %>
        <% bot = bots[result["bot"]] %>
        <% label, tone = workshop_outcome(result) %>
        <li class="card reveal reveal-<%= index + 1 %> space-y-2" data-testid="bot-result">
          <p class="flex items-center justify-between gap-2">
            <span class="text-lg font-bold"><%= bot&.name || result["bot"].humanize %></span>
            <span class="font-extrabold <%= debrief_text_class(tone) %>">+<%= workshop_outcome_points(result) %></span>
          </p>
          <p class="text-sm text-ink-muted"><%= bot&.description %></p>
          <p><span class="rounded-full border px-2 py-0.5 text-sm font-semibold <%= debrief_tone_classes(tone) %>" data-testid="bot-outcome"><%= label %></span></p>
          <% if (technique = techniques[result["gave_away"]]) %>
            <p class="text-sm"><%= workshop_giveaway(result, technique) %></p>
            <p class="text-sm text-ink-muted"><span class="font-semibold">Blue's defence:</span> <%= technique.defence_tip %></p>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>

  <section class="card" aria-labelledby="sent-heading">
    <h2 id="sent-heading" class="text-xl font-bold">The email you sent</h2>
    <p class="mt-3 text-lg font-bold"><%= campaign.rendered_subject %></p>
    <p class="text-sm text-ink-muted font-mono break-words">From: <%= campaign.rendered_from %></p>
    <div class="message-body mt-3 space-y-2"><%= sanitize campaign.rendered_body_html, tags: %w[ p ], attributes: [] %></div>
  </section>

  <section class="card" aria-labelledby="playbook-heading">
    <h2 id="playbook-heading" class="text-xl font-bold">Your playbook, and how Blue beats it</h2>
    <ul class="mt-3 space-y-3 text-sm">
      <% campaign.chosen_options.each do |option| %>
        <li>
          <span class="font-semibold"><%= workshop_slot_title(option.category) %>: <%= option.label %></span>
          · <%= option.technique.name %>
          <% if option.technique.attack_id %>
            <%= link_to option.technique.attack_id, option.technique.attack_url, target: "_blank", rel: "noopener noreferrer",
                  class: "font-mono text-xs text-ink-muted underline" %>
          <% end %>
          <span class="block text-ink-muted"><%= option.technique.defence_tip %></span>
        </li>
      <% end %>
    </ul>

    <div class="mt-6 flex flex-wrap gap-3">
      <%= button_to "Try another campaign", target_campaigns_path(target), class: "btn-red" %>
      <%= link_to "Play Blue's side", target.shift, class: "btn-ghost" %>
    </div>
  </section>
</div>
