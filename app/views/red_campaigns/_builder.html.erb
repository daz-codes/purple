<%# Red's card builder. One card per slot, within the budget; the email on the right is exactly what
    Blue would see, and every word of it comes from the cards. %>
<% target = campaign.target %>
<div id="campaign_builder" class="grid items-start gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
  <div class="space-y-6">
    <% TargetOption::CATEGORIES.each do |category| %>
      <section class="card p-4" aria-labelledby="slot-<%= category %>" data-testid="slot-<%= category %>">
        <h2 id="slot-<%= category %>" class="text-lg font-bold"><%= workshop_slot_title(category) %></h2>
        <p class="text-sm text-ink-muted"><%= workshop_slot_hint(category) %></p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          <% target.options_for(category).each do |option| %>
            <% chosen = campaign.chosen?(option) %>
            <li>
              <%= button_to (chosen ? red_campaign_choice_path(campaign, option) : red_campaign_choices_path(campaign)),
                    method: chosen ? :delete : :post, params: chosen ? {} : { option_id: option.id },
                    class: "h-full w-full rounded-xl border p-3 text-left cursor-pointer #{chosen ? "border-red-team bg-red-team-soft" : "border-line hover:border-red-team/60"}",
                    aria: { pressed: chosen }, form: { class: "h-full" } do %>
                <span class="flex items-start justify-between gap-2">
                  <span class="font-semibold"><%= option.label %></span>
                  <span class="shrink-0 rounded-full border border-line px-2 text-xs" data-testid="cost"><%= option.cost %></span>
                </span>
                <span class="mt-1 block text-xs text-ink-muted"><%= option.technique.name %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>

  <aside class="space-y-4 lg:sticky lg:top-4">
    <section class="card p-4" aria-labelledby="budget-heading">
      <p class="flex justify-between">
        <span id="budget-heading" class="font-semibold">Budget</span>
        <span data-testid="budget"><%= campaign.budget_left %> of <%= target.budget %> left</span>
      </p>
      <meter class="gauge gauge-productivity mt-2" min="0" max="<%= target.budget %>" value="<%= campaign.budget_left %>" aria-labelledby="budget-heading"></meter>
    </section>

    <% email = RedCampaign::Email.new(campaign.chosen_options) %>
    <section class="card p-0 overflow-hidden" aria-labelledby="preview-heading" data-testid="email-preview">
      <h2 id="preview-heading" class="border-b border-line px-4 py-2 text-xs font-semibold uppercase tracking-widest text-ink-muted">Your email, as Blue will see it</h2>
      <div class="p-4">
        <p class="text-lg font-bold"><%= email.subject || "(pick a story for the subject)" %></p>
        <dl class="mt-2 grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 text-sm">
          <dt class="text-ink-muted">From</dt><dd class="break-words font-mono"><%= email.from || "(pick a sender)" %></dd>
          <dt class="text-ink-muted">Sent</dt><dd><%= email.sent_at || "(pick a time)" %></dd>
        </dl>
        <div class="message-body mt-4 space-y-2"><%= email.body_html.presence || tag.p("(pick a story and a lure)", class: "text-ink-muted") %></div>
        <% if email.payload %>
          <p class="mt-4 rounded-lg border border-line bg-surface-sunken px-3 py-2 text-sm"><span class="font-semibold">Behind the lure:</span> <%= email.payload %></p>
        <% end %>
      </div>
    </section>

    <% if campaign.complete? %>
      <%= button_to "Launch at the Blue bots", red_campaign_launch_path(campaign), class: "btn-red w-full",
            form: { data: { turbo_confirm: "Launch this campaign? You can't change it afterwards." } } %>
    <% else %>
      <p class="text-sm text-ink-muted" data-testid="still-to-pick">Still to pick: <%= campaign.missing_slots.map { |slot| workshop_slot_title(slot).downcase }.to_sentence %>.</p>
    <% end %>
  </aside>
</div>
