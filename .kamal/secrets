# Secrets for config/deploy.yml (env/secret and accessories/*/env/secret). This file is committed, so
# it must never hold a raw credential: every value is read from the encrypted Rails credentials
# (config/credentials.yml.enc), which only config/master.key can open. Never commit master.key.
#
# Add the deploy secrets with `bin/rails credentials:edit` (see "Deployment" in README.md):
#
#   deploy:
#     database_password: <long random string, e.g. from `openssl rand -hex 32`>
#     backup_access_key_id: <object storage access key>
#     backup_secret_access_key: <object storage secret key>

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$(cat config/master.key)
PURPLE_DATABASE_PASSWORD=$(bin/rails credentials:fetch deploy.database_password)
BACKUP_S3_ACCESS_KEY_ID=$(bin/rails credentials:fetch deploy.backup_access_key_id)
BACKUP_S3_SECRET_ACCESS_KEY=$(bin/rails credentials:fetch deploy.backup_secret_access_key)
